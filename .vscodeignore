src/**
test/**
tsconfig.json
package-lock.json
.git/**
.gitignore
.claude/**
scripts/**
*.vsix
.vscode/**
.github/**

# Build artefacts that must never reach users
scripts/__pycache__/**
**/__pycache__/**
.npm-cache/**
.npm/**
ezimage-dev.vsix
ezimage-ci.vsix
ezimage-vsce.vsix
ezimage-local.vsix

# Source maps from TypeScript output (VS Code only needs .js)
out/**/*.js.map

# --- node_modules strategy ---
# Exclude the entire tree; then opt-in to the specific directories we ship.
node_modules/**/**

# --- Sharp and its native binaries are NEVER bundled ---
# They are compiled for the publisher's Node ABI and will fail to load inside
# VS Code's Electron. The extension prompts the user to install sharp on
# first use, when the native binary can be chosen for the user's own Node ABI.
node_modules/sharp/**
node_modules/@img/**
node_modules/color/**
node_modules/color-convert/**
node_modules/color-name/**
node_modules/color-string/**
node_modules/detect-libc/**
node_modules/semver/**
node_modules/simple-swizzle/**
node_modules/is-arrayish/**

# --- Drop dev/build tooling that should never ship ---
node_modules/esbuild/**
node_modules/@esbuild/**
node_modules/@emnapi/**
node_modules/typescript/**
node_modules/@types/**
node_modules/.bin/**
node_modules/.cache/**
node_modules/.package-lock.json

# Keep the extension folder + key project files
!out/**
!l10n/**
!package.json
!README.md
!README_CN.md
!LICENSE
!CHANGELOG.md
!icon.png
!docs/**

# tslib is required at runtime by @smithy/uuid and other helpers
!node_modules/tslib/package.json
!node_modules/tslib/tslib.js
!node_modules/tslib/tslib.es6.js
!node_modules/tslib/tslib.js.map

# --- Bundle only the runtime JS sources of the AWS SDK ---
# Each package is opted-in explicitly to avoid pulling .d.ts / .md / tests /
