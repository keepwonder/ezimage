{
  "name": "ezimage",
  "displayName": "EzImage",
  "description": "The ultimate effortless multi-platform image uploader for VS Code. Support R2, S3 and more.",
  "version": "1.0.3",
  "publisher": "kiang",
  "author": "Kiang (keepwonder)",
  "repository": {
    "type": "git",
    "url": "https://github.com/keepwonder/ezimage"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=18.17.0"
  },
  "extensionDependencies": [],
  "l10n": "./l10n",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:ezimage.uploadClipboard",
    "onCommand:ezimage.uploadClipboardAs",
    "onCommand:ezimage.uploadFile",
    "onCommand:ezimage.configure"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ezimage.uploadClipboard",
        "title": "%cmd.uploadClipboard.title%",
        "category": "EzImage"
      },
      {
        "command": "ezimage.uploadClipboardAs",
        "title": "%cmd.uploadClipboardAs.title%",
        "category": "EzImage",
        "description": "%cmd.uploadClipboardAs.description%"
      },
      {
        "command": "ezimage.uploadFile",
        "title": "%cmd.uploadFile.title%",
        "category": "EzImage"
      },
      {
        "command": "ezimage.configure",
        "title": "%cmd.configure.title%",
        "category": "EzImage"
      }
    ],
    "configuration": {
      "title": "EzImage",
      "properties": {
        "ezimage.provider": {
          "type": "string",
          "enum": [
            "r2"
          ],
          "default": "r2",
          "description": "%config.provider.description%"
        },
        "ezimage.r2.accountId": {
          "type": "string",
          "default": "",
          "description": "%config.r2.accountId.description%"
        },
        "ezimage.r2.accessKeyId": {
          "type": "string",
          "default": "",
          "description": "%config.r2.accessKeyId.description%"
        },
        "ezimage.r2.secretAccessKey": {
          "type": "string",
          "default": "",
          "description": "%config.r2.secretAccessKey.description%"
        },
        "ezimage.r2.bucketName": {
          "type": "string",
          "default": "",
          "description": "%config.r2.bucketName.description%"
        },
        "ezimage.r2.publicUrl": {
          "type": "string",
          "default": "",
          "description": "%config.r2.publicUrl.description%"
        },
        "ezimage.pathTemplate": {
          "type": "string",
          "default": "{yyyy}/{MM}/{timestamp}-{random}.{ext}",
          "description": "%config.pathTemplate.description%"
        },
        "ezimage.compress": {
          "type": "boolean",
          "default": true,
          "description": "%config.compress.description%"
        },
        "ezimage.maxWidth": {
          "type": "number",
          "default": 1920,
          "description": "%config.maxWidth.description%"
        },
        "ezimage.quality": {
          "type": "number",
          "default": 85,
          "description": "%config.quality.description%"
        },
        "ezimage.autoInstallSharp": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoInstallSharp.description%"
        },
        "ezimage.disableCompressionNotice": {
          "type": "boolean",
          "default": false,
          "description": "%config.disableCompressionNotice.description%"
        },
        "ezimage.insertFormat": {
          "type": "string",
          "enum": [
            "markdown",
            "html-center",
            "html-figure",
            "custom"
          ],
          "enumDescriptions": [
            "%config.insertFormat.enum.markdown%",
            "%config.insertFormat.enum.htmlCenter%",
            "%config.insertFormat.enum.htmlFigure%",
            "%config.insertFormat.enum.custom%"
          ],
          "default": "markdown",
          "description": "%config.insertFormat.description%"
        },
        "ezimage.insertWidth": {
          "type": "string",
          "default": "100%",
          "pattern": "^(|auto|[0-9]+(%|px|em|rem|vw|vh)?)$",
          "description": "%config.insertWidth.description%"
        },
        "ezimage.insertAlign": {
          "type": "string",
          "enum": [
            "none",
            "left",
            "center",
            "right"
          ],
          "enumDescriptions": [
            "%config.insertAlign.enum.none%",
            "%config.insertAlign.enum.left%",
            "%config.insertAlign.enum.center%",
            "%config.insertAlign.enum.right%"
          ],
          "default": "none",
          "description": "%config.insertAlign.description%"
        },
        "ezimage.insertCustomTemplate": {
          "type": "string",
          "default": "",
          "description": "%config.insertCustomTemplate.description%"
        },
        "ezimage.insertIncludeName": {
          "type": "boolean",
          "default": true,
          "description": "%config.insertIncludeName.description%"
        },
        "ezimage.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN"
          ],
          "enumDescriptions": [
            "%config.language.enum.auto%",
            "%config.language.enum.en%",
            "%config.language.enum.zh-CN%"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "ezimage.uploadClipboard",
        "when": "editorTextFocus && editorLangId == markdown",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ezimage.uploadClipboard",
          "when": "editorLangId == markdown",
          "group": "modification"
        },
        {
          "command": "ezimage.uploadFile",
          "when": "editorLangId == markdown",
          "group": "modification@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run verify && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "verify": "python3 scripts/package-vsix.py --verify ezimage-dev.vsix && rm -f ezimage-dev.vsix",
    "package": "npm run compile && python3 scripts/package-vsix.py --verify ezimage-dev.vsix",
    "vsce:package": "npm run compile && vsce package --no-git-tag-version",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:dry": "standard-version --dry-run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.27.3",
    "standard-version": "^9.5.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.450.0"
  },
  "optionalDependencies": {
    "sharp": "^0.33.0"
  }
}
